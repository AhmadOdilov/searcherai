// Searcher AI — ma'lumotlar bazasi sxemasi
//
// Dizayn qarorlari:
//  · Generatsiya natijalari `Json` ustunda saqlanadi. AI javobining shakli
//    modullar rivojlangani sayin o'zgaradi — har o'zgarishda migratsiya
//    yozmaslik uchun. Shakl `lib/validations/` dagi zod sxemalari bilan
//    kod tomonida qat'iy tekshiriladi.
//  · Har bir generatsiya jadvalida `status` bor — AI so'rovi uzoq davom etadi,
//    shuning uchun yozuv avval PENDING bo'lib yaratiladi, keyin to'ldiriladi.
//    Bu Step 5 (performance) da fon rejimiga o'tish uchun zamin.
//  · Foydalanuvchi o'chirilsa uning barcha kontenti ham o'chadi (Cascade).

// Prisma 7: klient `lib/generated/prisma` ga generatsiya qilinadi va
// ulanish manzili (DATABASE_URL) sxemada emas, `prisma7.config.ts` da turadi.
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Sanoq turlari ───────────────────────────────────────────────────────────

enum Role {
  TEACHER
  ADMIN
}

/// Interfeys va generatsiya tili. TZ: o'zbek, rus, ingliz.
enum Language {
  UZ
  RU
  EN
}

/// Uzoq davom etadigan AI generatsiyasining holati.
enum GenerationStatus {
  PENDING
  READY
  FAILED
}

/// Dars turi — TZ'dagi "yangi mavzu / mustahkamlash / nazorat".
enum LessonType {
  NEW_TOPIC
  REINFORCEMENT
  ASSESSMENT
}

// ─── Modellar ────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// bcrypt/argon2 hash. Parol hech qachon ochiq saqlanmaydi.
  passwordHash String
  fullName     String
  /// Ixtiyoriy — TZ'da telefon orqali kirish ham ko'rsatilgan.
  phone        String?  @unique
  role         Role     @default(TEACHER)
  /// Foydalanuvchining standart interfeys tili.
  language     Language @default(UZ)
  /// Profil ma'lumotlari: maktab, ish tajribasi, o'qitadigan fanlar.
  /// Auth moduli kengaytirishi uchun moslashuvchan qoldirilgan.
  profile      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  lessonPlans    LessonPlan[]
  presentations  Presentation[]
  calendarPlans  CalendarPlan[]

  @@index([createdAt])
}

/// Sessiya — JWT cookie'ning bazadagi "ildizi".
///
/// Nega JWT'ning o'zi yetarli emas: imzolangan token muddati tugamaguncha
/// yaroqli bo'lib qoladi. Ya'ni "chiqish" (logout) faqat cookie'ni o'chiradi,
/// o'g'irlangan token esa ishlashda davom etadi. Bazada yozuv bo'lsa — uni
/// o'chirish bilan sessiya DARHOL kuchdan qoladi.
///
/// JWT ichida faqat ikki narsa: sessiya id va foydalanuvchi id. Shu tufayli
/// `proxy.ts` bazaga tegmasdan, faqat imzoni tekshirib qaror qabul qiladi.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  /// Diagnostika uchun: qaysi brauzer va qaysi manzildan kirilgan.
  userAgent String?
  ip        String?

  createdAt DateTime @default(now())

  /// Foydalanuvchining barcha sessiyalarini topish va o'chirish uchun.
  @@index([userId])
  /// Eskirgan sessiyalarni tozalash uchun.
  @@index([expiresAt])
}

/// Muvaffaqiyatsiz kirish urinishlari — brute-force himoyasi.
///
/// ── Nega alohida jadval ───────────────────────────────────────────────────
/// `Session` ga ustun qo'shib bo'lmaydi: sessiya faqat MUVAFFAQIYATLI
/// kirishdan keyin paydo bo'ladi, hisoblash kerak bo'lgan narsa esa aynan
/// muvaffaqiyatsiz urinishlar. `User` ga qo'shish ham ishlamaydi —
/// mavjud bo'lmagan email bilan urinishni ham hisoblash kerak (aks holda
/// hujumchi mavjud bo'lmagan emaillar orqali cheksiz urinadi).
///
/// ── Nega Redis emas ───────────────────────────────────────────────────────
/// Yangi xizmat MVP uchun ortiqcha. Yozuvlar kam (faqat muvaffaqiyatsiz
/// urinishlar) va ular eskirgach o'chiriladi.
model LoginAttempt {
  id String @id @default(cuid())

  /// Kim urinayotgani: email (kichik harfda) yoki IP manzil.
  ///
  /// Ikkisi ALOHIDA yoziladi va alohida hisoblanadi. Sabab: bitta
  /// emailga hujum va bitta IP dan ko'p emailga hujum — ikki xil holat,
  /// ikkalasini ham to'xtatish kerak.
  identifier String
  /// "email" yoki "ip" — bir xil qiymat ikki turda bo'lishi mumkin emas,
  /// lekin tur bo'yicha ajratish diagnostikani osonlashtiradi.
  kind       String

  createdAt DateTime @default(now())

  /// Oyna ichidagi urinishlarni sanash va eskirganini tozalash uchun.
  @@index([identifier, createdAt])
  @@index([createdAt])
}

model LessonPlan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Fan nomi, masalan "Matematika", "Tarix".
  subject String
  /// Sinf/daraja. Matn — "7-sinf", "1-kurs" kabi qiymatlar uchun.
  grade   String
  topic   String
  /// Dars davomiyligi, daqiqada.
  durationMinutes Int        @default(45)
  lessonType      LessonType @default(NEW_TOPIC)
  language        Language   @default(UZ)

  status GenerationStatus @default(PENDING)
  /// Struktura qilingan dars ishlanmasi. Shakli: lib/validations/lesson-plan.ts
  /// (maqsad, kutilayotgan natijalar, bosqichlar, metodlar, uy vazifasi).
  content Json?
  /// status = FAILED bo'lganda sababi — foydalanuvchiga ko'rsatish uchun.
  errorMessage String?

  /// Generatsiya kuzatuvi (Step 5 da o'lchash uchun): qaysi model, qancha token.
  aiModel      String?
  aiDurationMs Int?
  /// AI'ga necha marta murojaat qilingani.
  ///
  /// 1 dan katta bo'lsa — birinchi javob zod sxemasidan o'tmagan va
  /// modelga qayta so'rov ketgan. Bu generatsiya narxini IKKI BARAVAR
  /// oshiradi, shuning uchun alohida o'lchanadi (`npm run ai:stats`).
  aiAttempts   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  presentations Presentation[]

  /// Foydalanuvchining o'z darslari ro'yxati — eng yangisi birinchi.
  @@index([userId, createdAt])
  /// "Matematika 7-sinf" bo'yicha filtr va kesh uchun.
  @@index([subject, grade])
  @@index([status])
}

model Presentation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Dars ishlanmasiga bog'lanish IXTIYORIY — TZ'ga ko'ra prezentatsiya
  /// alohida kiritilgan mavzudan ham yaratilishi mumkin.
  /// Dars o'chirilsa prezentatsiya qoladi, faqat bog'lanish uziladi (SetNull).
  lessonPlanId String?
  lessonPlan   LessonPlan? @relation(fields: [lessonPlanId], references: [id], onDelete: SetNull)

  /// Prezentatsiya mavzusi — dars ishlanmasidan ko'chiriladi yoki mustaqil
  /// rejimda foydalanuvchi kiritadi. Qayta generatsiya uchun ham kerak.
  topic   String
  /// Mustaqil rejimda ixtiyoriy; dars ishlanmasidan kelganda to'ldiriladi.
  subject String?
  grade   String?

  /// AI tanlagan sarlavha. PENDING holatida hali bo'sh — shuning uchun
  /// ixtiyoriy. UI'da `title ?? topic` ko'rsatiladi.
  title    String?
  language Language @default(UZ)

  status GenerationStatus @default(PENDING)
  /// Slaydlar strukturasi (sarlavha + bullet'lar). Shakli:
  /// lib/validations/presentation.ts
  content Json?

  /// Generatsiya qilingan .pptx faylning saqlagichdagi yo'li.
  ///
  /// DIQQAT: fayllar `public/` papkasida SAQLANMAYDI. Aks holda Next.js
  /// ularni statik tarqatadi va yuklab olish route'idagi egalik tekshiruvi
  /// chetlab o'tilardi — havolani bilgan har kim boshqa o'qituvchining
  /// faylini olardi. Fayllar `storage/presentations/` da turadi va faqat
  /// `GET /api/presentations/[id]/download` orqali beriladi.
  filePath String?
  /// Fayl hajmi, baytda — yuklab olish UI'sida ko'rsatish uchun.
  fileSize   Int?
  slideCount Int?

  errorMessage String?

  /// Generatsiya kuzatuvi (Step 5 da o'lchash uchun).
  aiModel      String?
  aiDurationMs Int?
  /// AI'ga necha marta murojaat qilingani.
  ///
  /// 1 dan katta bo'lsa — birinchi javob zod sxemasidan o'tmagan va
  /// modelga qayta so'rov ketgan. Bu generatsiya narxini IKKI BARAVAR
  /// oshiradi, shuning uchun alohida o'lchanadi (`npm run ai:stats`).
  aiAttempts   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([lessonPlanId])
  @@index([status])
}

model CalendarPlan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject String
  grade   String
  /// Davr nomi — "1-chorak", "2026-2027 o'quv yili".
  period  String
  /// Davr uzunligi, haftada.
  weeks   Int
  /// Haftalik dars soati.
  hoursPerWeek Int
  /// Davr boshlanish sanasi — hafta sanalarini hisoblash uchun.
  startDate    DateTime
  language     Language @default(UZ)

  /// AI tanlagan sarlavha. PENDING holatida hali bo'sh.
  title String?

  status GenerationStatus @default(PENDING)
  /// Jadval qatorlari. Shakli: lib/validations/calendar-plan.ts
  content Json?

  /// Generatsiya qilingan .xlsx faylning saqlagichdagi yo'li.
  ///
  /// Prezentatsiyadagi kabi fayllar `public/` da EMAS — `storage/` da.
  /// Sababi: `public/` dagi fayllarni Next.js statik tarqatadi va yuklab
  /// olishdagi egalik tekshiruvi chetlab o'tilardi.
  filePath String?
  fileSize Int?
  /// Jadvaldagi qatorlar soni — ro'yxatda ko'rsatish uchun.
  rowCount Int?

  errorMessage String?

  /// Generatsiya kuzatuvi (Step 5 da o'lchash uchun).
  aiModel      String?
  aiDurationMs Int?
  /// AI'ga necha marta murojaat qilingani.
  ///
  /// 1 dan katta bo'lsa — birinchi javob zod sxemasidan o'tmagan va
  /// modelga qayta so'rov ketgan. Bu generatsiya narxini IKKI BARAVAR
  /// oshiradi, shuning uchun alohida o'lchanadi (`npm run ai:stats`).
  aiAttempts   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([subject, grade])
  @@index([status])
}
