# ─────────────────────────────────────────────────────────────────────────────
# Searcher AI — PRODUCTION muhit o'zgaruvchilari (VPS + Docker).
#
# Ishlatish:
#   cp .env.production.example .env
#   nano .env          ← quyidagi ❗ belgili qatorlarni to'ldiring
#   ./scripts/deploy.sh
#
# Bu faylda HAQIQIY sirlar YO'Q — faqat namunalar. `.env` esa hech qachon
# git'ga tushmaydi (.gitignore da) va serverda qolishi kerak.
#
# ❗ = majburiy, siz to'ldirasiz
# ○  = ixtiyoriy, standart qiymat ishlaydi
# ─────────────────────────────────────────────────────────────────────────────


# ═══ 1. DOMEN VA SERTIFIKAT ══════════════════════════════════════════════════

# ❗ Sayt domeni — "https://" va oxirgi "/" SIZ. Nginx va Let's Encrypt
#    aynan shu nomni ishlatadi. DNS'da A yozuvi shu serverga qaragan
#    bo'lishi SHART (DEPLOY.md, 2-qadam).
DOMAIN="searcher-ai.uz"

# ❗ Let's Encrypt uchun email. Sertifikat muddati tugayotganida shu
#    manzilga ogohlantirish keladi. Haqiqiy, o'qiladigan pochta bo'lsin.
CERTBOT_EMAIL="siz@example.com"


# ═══ 2. MA'LUMOTLAR BAZASI ═══════════════════════════════════════════════════
#
# Postgres konteyner ichida ishlaydi va tashqariga port ochmaydi, lekin
# parol baribir kuchli bo'lsin — konteynerlar bir tarmoqda turadi.
#
# Parol yaratish:   openssl rand -base64 32

# ○ Baza foydalanuvchisi va nomi
POSTGRES_USER="searcher"
POSTGRES_DB="searcher_ai"

# ❗ Baza paroli
POSTGRES_PASSWORD=""

# DIQQAT: DATABASE_URL bu yerda YOZILMAYDI.
# Uni `docker-compose.prod.yml` yuqoridagi uchta qiymatdan o'zi yig'adi
# (host = `postgres` konteyner nomi). Bu yerga qo'lda yozsangiz ham,
# compose'dagi qiymat ustun turadi — chalkashmaslik uchun qo'ymang.


# ═══ 3. ILOVA ════════════════════════════════════════════════════════════════

# ❗ Ilovaning tashqi manzili. DOMAIN bilan bir xil bo'lishi kerak,
#    lekin "https://" bilan.
APP_URL="https://searcher-ai.uz"

# ❗ Sessiya kalitlarini imzolash siri. Kamida 32 belgi.
#    Yaratish:   openssl rand -base64 48
#
#    DIQQAT: bu qiymat o'zgarsa BARCHA o'qituvchilar tizimdan chiqib
#    ketadi va qaytadan kirishlari kerak bo'ladi. Bir marta yaratib,
#    keyin tegmang.
AUTH_SECRET=""


# ═══ 4. SUN'IY INTELLEKT ═════════════════════════════════════════════════════
#
# Kalit bo'sh qoldirilsa ilova ishlaydi, lekin generatsiya tugmalari
# tushunarli xato beradi. Demo uchun albatta to'ldiring.

# Bir IP'dan soatiga ruxsat etilgan ro'yxatdan o'tishlar soni.
#
# Standart 10. Maktabda seminar o'tkazsangiz (30 o'qituvchi bitta
# wi-fi ostidan bir soatda ro'yxatdan o'tadi) — vaqtincha oshiring.
REGISTER_MAX_PER_IP="10"

# ○ Transport turi: "openai" (OpenAI-mos hamma xizmatlar) yoki "anthropic"
AI_PROVIDER="openai"

# ❗ API kaliti
AI_API_KEY=""

# ○ Model. Yandex AI Studio uchun namuna:
#     AI_MODEL="gpt://<folder-id>/yandexgpt-5-pro/latest"
AI_MODEL=""

# ○ Manzil. Yandex AI Studio uchun:
#     AI_BASE_URL="https://ai.api.cloud.yandex.net/v1"
AI_BASE_URL=""

# ○ Kalendar reja uchun ALOHIDA model. Bu modul eng uzun ro'yxatni
#   tuzadi va modellar bu vazifada sezilarli farq qiladi.
#     CALENDAR_PLAN_AI_MODEL="gpt://<folder-id>/qwen3-235b-a22b-fp8/latest"
CALENDAR_PLAN_AI_MODEL=""

# ○ AI qidiruv uchun ALOHIDA model. Qidiruv — yagona modul bo'lib ERKIN
#   MATN yozadi, ya'ni modelning o'zbek tili sifati aynan shu yerda
#   ko'rinadi. Sinovda qwen3 yandexgpt'dan sezilarli tushunarliroq
#   o'zbekcha yozdi.
#     SEARCH_AI_MODEL="gpt://<folder-id>/qwen3-235b-a22b-fp8/latest"
SEARCH_AI_MODEL=""

# ● Prezentatsiya matni modeli — MAJBURIY, AI_MODEL ga QAYTMAYDI.
#   Prezentatsiya eng ko'p erkin matn yozadigan modul; jim zaxira model
#   tanlovini o'lchanmas qilib qo'yardi. Bo'sh bo'lsa prezentatsiya
#   generatsiyasi tushunarli xato bilan to'xtaydi.
#     PRESENTATION_AI_MODEL="gpt://<folder-id>/qwen3-235b-a22b-fp8/latest"
PRESENTATION_AI_MODEL=""

# ○ Rasm tushunish (vision) modeli. AI_MODEL ga QAYTMAYDI — oddiy matn
#   modeli rasmni tushunmaydi. Bo'sh bo'lsa funksiya o'chadi.
#     VISION_AI_MODEL="gpt://<folder-id>/qwen3.6-35b-a3b/latest"
VISION_AI_MODEL=""


# ○ Bitta AI so'roviga ajratilgan vaqt (millisekund).
#   Nginx chegarasi 300 soniya, shuning uchun bundan oshirmang.
AI_TIMEOUT_MS="90000"
AI_MAX_RETRIES="2"
AI_MAX_TOKENS="16000"


# ═══ 5. FAYL SAQLAGICHI ══════════════════════════════════════════════════════
#
# VPS uchun "local" to'g'ri tanlov: fayllar Docker volume'ida yashaydi va
# konteyner qayta qurilganda yo'qolmaydi.
#
# "s3" faqat bir nechta serverga kengaytirilganda yoki Vercel kabi
# serverless muhitda kerak bo'ladi.
STORAGE_DRIVER="local"

# Faqat STORAGE_DRIVER="s3" bo'lganda:
S3_BUCKET=""
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"


# ═══ 6. YORDAM KONTAKTI ══════════════════════════════════════════════════════
#
# Har sahifaning pastida ko'rinadigan "Yordam kerakmi?" havolasi.
# "@" belgisisiz, faqat Telegram foydalanuvchi nomi.
#
# DIQQAT: bu qiymat BUILD paytida kodga yoziladi. O'zgartirgandan keyin
# `./scripts/update.sh` (yoki `--build` bilan qayta ko'tarish) kerak —
# faqat konteynerni qayta ishga tushirish yetarli emas.
NEXT_PUBLIC_SUPPORT_TELEGRAM="expelled_coders"
