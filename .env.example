# ─────────────────────────────────────────────────────────────────────────────
# Searcher AI — muhit o'zgaruvchilari
#
# Bu faylni nusxalab .env qiling va qiymatlarni to'ldiring:
#   cp .env.example .env
#
# .env hech qachon git'ga tushmaydi (.gitignore da).
# ─────────────────────────────────────────────────────────────────────────────

# ── Ma'lumotlar bazasi ───────────────────────────────────────────────────────
# Ikki variant bor, bittasini tanlang:
#
#  A) Docker (docker compose up -d) — host portida 5433:
#     postgresql://searcher:searcher_dev_password@localhost:5433/searcher_ai?schema=public
#
#  B) Mahalliy Postgres — host portida 5432:
#     postgresql://searcher:searcher_dev_password@localhost:5432/searcher_ai?schema=public
#
# Quyida B varianti (mahalliy server) standart sifatida turadi.
DATABASE_URL="postgresql://searcher:searcher_dev_password@localhost:5432/searcher_ai?schema=public"

# ── Ilova ────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ── Autentifikatsiya ─────────────────────────────────────────────────────────
# Sessiya JWT'larini imzolash kaliti. Kamida 32 belgi.
# O'zingiznikini yarating:  openssl rand -base64 48
#
# DIQQAT: bu kalit o'zgarsa barcha foydalanuvchilar tizimdan chiqib ketadi.
# Productionda albatta boshqa (tasodifiy) qiymat ishlatilsin.
AUTH_SECRET=""

# ── AI qatlami ───────────────────────────────────────────────────────────────
# AI_PROVIDER — qaysi transport ishlatilsin:
#   "openai"    → OpenAI-mos (OpenAI, OpenRouter, Gemini compat, Groq, mahalliy
#                 modellar — hammasi shu orqali, faqat AI_BASE_URL o'zgaradi)
#   "anthropic" → Anthropic Messages API
# Bir IP'dan soatiga ruxsat etilgan ro'yxatdan o'tishlar soni.
#
# Standart 10. Maktabda seminar o'tkazsangiz (30 o'qituvchi bitta
# wi-fi ostidan bir soatda ro'yxatdan o'tadi) — vaqtincha oshiring.
REGISTER_MAX_PER_IP="10"

AI_PROVIDER="openai"

# API kaliti. Bo'sh qoldirilsa AI funksiyalari o'chadi va foydalanuvchiga
# tushunarli xabar qaytadi (ilova qulab tushmaydi).
AI_API_KEY=""

# Model nomi. Bo'sh qoldirilsa provider bo'yicha standart model ishlatiladi:
#   openai    → gpt-4o-mini
#   anthropic → claude-opus-5
#
# Yandex AI Studio modellari MAXSUS formatda bo'ladi:
#   AI_MODEL="gpt://<folder-id>/yandexgpt-5-pro/latest"
# Folder ID va mavjud modellar ro'yxatini olish:
#   curl https://ai.api.cloud.yandex.net/v1/models -H "Authorization: Bearer $AI_API_KEY"
AI_MODEL=""

# Base URL. Bo'sh qoldirilsa provider bo'yicha standart:
#   openai    → https://api.openai.com/v1
#   anthropic → https://api.anthropic.com
#
# Boshqa xizmatlar uchun namunalar (AI_PROVIDER="openai" bilan):
#   OpenRouter → https://openrouter.ai/api/v1
#   Gemini     → https://generativelanguage.googleapis.com/v1beta/openai
#   Groq       → https://api.groq.com/openai/v1
#   Ollama     → http://localhost:11434/v1
#   Yandex AI Studio → https://ai.api.cloud.yandex.net/v1
AI_BASE_URL=""

# Bitta AI so'rovi uchun maksimal kutish vaqti (millisekund).
# Dars ishlanmasi kabi uzun generatsiyalar uchun 60s kam bo'lishi mumkin.
AI_TIMEOUT_MS="90000"

# Vaqtinchalik xatolarda (429, 5xx, tarmoq) necha marta qayta urinish.
AI_MAX_RETRIES="2"

# Javobdagi maksimal token soni (standart qiymat, chaqiruvda o'zgartirilishi mumkin).
AI_MAX_TOKENS="16000"

# Kalendar reja uchun ALOHIDA model (ixtiyoriy).
#
# Bu modul eng uzun ro'yxatni generatsiya qiladi (20+ hafta) va modellar
# bu vazifada sezilarli farq qiladi. Bo'sh qoldirilsa AI_MODEL ishlatiladi.
#
# Yandex namunasi:
#   CALENDAR_PLAN_AI_MODEL="gpt://<folder-id>/qwen3-235b-a22b-fp8/latest"
CALENDAR_PLAN_AI_MODEL=""

# AI qidiruv uchun ALOHIDA model (ixtiyoriy).
#
# Qidiruv — yagona modul bo'lib, ERKIN MATN yozadi (qolganlari qisqa,
# tayyor shakldagi maydonlarni to'ldiradi). Erkin matnda modelning
# o'zbek tili sifati darhol ko'rinadi va modellar keskin farq qiladi.
#
# Yandex namunasi:
#   SEARCH_AI_MODEL="gpt://<folder-id>/qwen3-235b-a22b-fp8/latest"
SEARCH_AI_MODEL=""

# Prezentatsiya matni uchun model — MAJBURIY.
#
# DIQQAT: bu AI_MODEL ga QAYTMAYDI. Prezentatsiya tizimdagi eng ko'p
# ERKIN MATN yozadigan modul (sarlavha, asosiy fikr, bandlar, kartalar,
# bosqichlar) va modelning o'zbek tili sifati natijada darhol ko'rinadi.
# Jim zaxira bu tanlovni o'lchanmas qilib qo'ygan edi.
#
# Bo'sh qoldirilsa prezentatsiya generatsiyasi tushunarli xato bilan
# to'xtaydi (ilova qulab tushmaydi, boshqa modullar ishlayveradi).
#
# Yandex namunasi:
#   PRESENTATION_AI_MODEL="gpt://<folder-id>/qwen3-235b-a22b-fp8/latest"
PRESENTATION_AI_MODEL=""

# Rasm tushunish (vision) uchun model.
#
# DIQQAT: bu AI_MODEL ga QAYTMAYDI — oddiy matn modeli rasmni tushunmaydi.
# Bo'sh qoldirilsa rasm tahlili funksiyasi butunlay o'chadi.
#
# Yandex AI Studio'da rasm qabul qiladigan model:
#   VISION_AI_MODEL="gpt://<folder-id>/qwen3.6-35b-a3b/latest"
VISION_AI_MODEL=""


# ── Fayl saqlagichi ──────────────────────────────────────────────────────────
# Generatsiya qilingan .pptx va .xlsx fayllar qayerda saqlanadi.
#
#   "local" — disk (storage/ papka). VPS va Docker uchun.
#   "s3"    — S3-mos xizmat. Serverless (Vercel) uchun MAJBURIY, chunki
#             u yerda fayl tizimi faqat o'qish uchun ochiq.
STORAGE_DRIVER="local"

# ── S3 sozlamalari (faqat STORAGE_DRIVER="s3" bo'lganda) ─────────────────────
# Cloudflare R2, AWS S3 va MinIO — uchalasi ham bir xil API'ga ega,
# farq faqat S3_ENDPOINT da.
#
#   AWS S3     → S3_ENDPOINT bo'sh, S3_REGION="us-east-1" kabi
#   Cloudflare → S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
#                S3_REGION="auto"
#   MinIO      → S3_ENDPOINT="http://localhost:9000"
S3_BUCKET=""
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"
