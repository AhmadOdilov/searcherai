{
  "name": "serchforschool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/strip-standalone-env.mjs",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "ai:smoke": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/ai-smoke.ts",
    "test": "node --conditions=react-server --import tsx --test \"tests/**/*.test.ts\"",
    "test:e2e": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env --conditions=react-server --import tsx --test-concurrency=1 --test-global-setup=tests/e2e/helpers/global-server.ts --test \"tests/e2e/**/*.e2e.ts\"",
    "test:browser": "playwright test",
    "test:smoke": "npm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env --conditions=react-server --import tsx --test-concurrency=1 --test-global-setup=tests/smoke/helpers/global-setup.ts --test \"tests/smoke/shared/*.smoke.ts\" \"tests/smoke/standalone.smoke.ts\"",
    "test:smoke:docker": "SMOKE_TARGET=docker node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env --conditions=react-server --import tsx --test-concurrency=1 --test-global-setup=tests/smoke/helpers/global-setup.ts --test \"tests/smoke/shared/*.smoke.ts\" \"tests/smoke/docker.smoke.ts\"",
    "ai:stats": "tsx --conditions=react-server --tsconfig tsconfig.json --env-file-if-exists=.env scripts/ai-stats.ts",
    "db:seed-curriculum": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-curriculum.ts",
    "curriculum:extract": "tsx scripts/extract-curriculum.ts",
    "search:gate": "tsx --conditions=react-server --env-file-if-exists=.env scripts/search-quality-gate.ts",
    "search:gate-v5": "tsx --conditions=react-server --env-file-if-exists=.env scripts/search-quality-gate-v5.ts",
    "search:eval-v5": "tsx --conditions=react-server --env-file-if-exists=.env scripts/evaluate-v5-full.ts",
    "search:eval-multiturn": "tsx --conditions=react-server --env-file-if-exists=.env scripts/evaluate-v5-multiturn.ts",
    "search:ablation-v5": "tsx --conditions=react-server --env-file-if-exists=.env scripts/ablation-v5.ts",
    "search:benchmark-v5": "tsx --conditions=react-server --env-file-if-exists=.env scripts/generate-v5-benchmark.ts",
    "search:audit-benchmark": "tsx --conditions=react-server --env-file-if-exists=.env scripts/audit-benchmark-integrity.ts",
    "search:eval-500": "tsx --conditions=react-server --env-file-if-exists=.env scripts/evaluate-search-500.ts",
    "search:eval-v4": "tsx --conditions=react-server --env-file-if-exists=.env scripts/evaluate-v4-full.ts",
    "search:eval-e2e": "tsx --conditions=react-server --env-file-if-exists=.env scripts/audit-e2e-quality.ts",
    "search:audit-dataset": "tsx --conditions=react-server --env-file-if-exists=.env scripts/audit-golden-dataset.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.45.0",
    "next": "16.3.4",
    "next-intl": "^4.14.4",
    "pg": "^8.23.0",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "jszip": "^3.10.2",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
